{
  "name": "4link",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "4Link · 四连引力 —— 方形重力棋盘上的 2–6 人连线游戏、残局谜题、新手教程与整站外观自定义",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:app": "tsc && cross-env APP_BUILD=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build:app && cap sync android",
    "electron:dev": "npm run build:app && electron .",
    "electron:build": "npm run build:app && electron-builder --win portable nsis",
    "electron:dir": "npm run build:app && electron-builder --dir"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.adlambxd.fourlink",
    "productName": "4Link",
    "copyright": "Copyright © 2026 4Link",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "4Link-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "4Link-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  }
}
